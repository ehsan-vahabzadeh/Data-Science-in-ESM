{
    "python-envs.defaultEnvManager": "ms-python.python:system",
    "files.associations": {
        "*.py": "python"
    },
    "editor.semanticHighlighting.enabled": true,
    "editor.tokenColorCustomizations": {
        "comments": "#6A9955",
        "textMateRules": [
            {
                "scope": [
                    "comment",
                    "punctuation.definition.comment"
                ],
                "settings": {
                    "foreground": "#6A9955",
                    "fontStyle": "italic"
                }
            }
        ]
    }
}
