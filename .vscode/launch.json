{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "guiEventLoop": "none",
            "env": {
                "MPLBACKEND": "Agg"
            }
        }
    ]
}
